# Zenible Meeting Intelligence Desktop Client Configuration

# Server URL (where zmi-server is running)
SERVER_URL=http://localhost:8000/api/v1

# Frontend URL (web app for signup/login)
FRONTEND_URL=http://localhost:5180

# Google Calendar integration (stays client-side)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
